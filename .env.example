# Optional: without these values the site provides a read-only catalog.
# Create your own D1 database, apply drizzle/0000_early_the_watchers.sql,
# then add these SERVER-ONLY variables in Vercel. Never use NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
# Required when the database is enabled. Any username + this password signs in.
APP_PASSWORD=
